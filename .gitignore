# Binaires compilées
/zapette
/zapette-*

# Données runtime : copies de source, snapshots et meta.json. /data est le
# défaut du binaire ; /.data est le data_dir des essais réels de
# l'opérateur depuis le dépôt (config.yaml local) — jamais commités :
# les copies de source contiennent les URL de flux du fournisseur.
/data/
/.data/

# Frontend (dashboard embarqué) : dépendances npm seulement. Le build de
# production frontend/dist/ est COMMITTÉ : c'est lui que embed.FS embarque
# (frontend/embed.go), le binaire se construit (et se teste) sur un clone
# vierge sans toolkit Node.
node_modules/

# Éditeurs et OS
*.swp
.DS_Store

# Config locale de l'opérateur (peut contenir des secrets) : modèle = config.example.yaml
/config.yaml
